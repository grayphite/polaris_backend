{
  "info": {
    "name": "Polaris AI Chat API",
    "description": "Complete API collection for AI Chat functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5003/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "chat_id",
      "value": "11",
      "type": "string"
    },
    {
      "key": "ai_chat_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user.test@example.com\",\n  \"senha\": \"StrongPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/login",
              "host": ["{{base_url}}"],
              "path": ["users", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Chat",
      "item": [
        {
          "name": "Send AI Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": {{chat_id}},\n  \"user_question\": \"What is the capital of France?\",\n  \"ai_model\": \"gpt-3.5-turbo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai-chats/send-message",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "send-message"]
            }
          }
        },
        {
          "name": "List AI Chats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/chats/{{chat_id}}/ai-chats?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["chats", "{{chat_id}}", "ai-chats"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get AI Chat by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai-chats/{{ai_chat_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "{{ai_chat_id}}"]
            }
          }
        },
        {
          "name": "Update AI Chat",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_question\": \"What is the capital of France? (Updated)\",\n  \"ai_answer\": \"The capital of France is Paris. (Updated answer)\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai-chats/{{ai_chat_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "{{ai_chat_id}}"]
            }
          }
        },
        {
          "name": "Delete AI Chat",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai-chats/{{ai_chat_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "{{ai_chat_id}}"]
            }
          }
        },
        {
          "name": "Restore AI Chat",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai-chats/{{ai_chat_id}}/restore",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "{{ai_chat_id}}", "restore"]
            }
          }
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai-chats/stats?chat_id={{chat_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "stats"],
              "query": [
                {
                  "key": "chat_id",
                  "value": "{{chat_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ai-chats/health",
              "host": ["{{base_url}}"],
              "path": ["ai-chats", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Setup (Create Project & Chat)",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AI Chat Test Project\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects",
              "host": ["{{base_url}}"],
              "path": ["projects"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('project_id', response.id);",
                  "    console.log('Project ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AI Chat Test Chat\",\n  \"project_id\": {{project_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/chats",
              "host": ["{{base_url}}"],
              "path": ["chats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('chat_id', response.id);",
                  "    console.log('Chat ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
