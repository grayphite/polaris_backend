# POLARIS Backend - Variáveis de Ambiente

# Banco de Dados
# Para desenvolvimento local, deixe comentado para usar SQLite
# Para produção, configure com PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Segurança
# OBRIGATÓRIO em produção - gere uma chave segura
SECRET_KEY=polaris-dev-secret-key-change-in-production

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=src/main.py

# Configurações da aplicação
APP_NAME=POLARIS
APP_VERSION=1.0.0

# Configurações de CORS (opcional - padrão permite todas as origens)
CORS_ORIGINS=http://localhost:3000,https://polaris.exemplo.com

# Configurações de upload (futuro) # 16MB
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads/

# Configurações de email (futuro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=user@email.com
SMTP_PASSWORD="some-app-password"
FROM_EMAIL=sender@email.com


# Configurações de IA (futuro)
OPENAI_API_KEY=sua-chave-openai
CLAUDE_API_KEY=sua-chave-claude

# Configurações de logging
LOG_LEVEL=INFO
LOG_FILE=logs/polaris.log

APP_BASE_URL="http://localhost:3000"
